local function fireGun()
    local remote = getGunRemote()
    if not remote then return end

    local targetPart, targetPlayer = getNearestEnemyTarget()
    local targetPos = targetPart and targetPart.Position or Vector3.new(-1750.3, 511.3, 1990)
    local hitInstance = targetPart or Workspace

    if shootMode == "Flick" and targetPart then
        local oldCFrame = Camera.CFrame
        Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        targetPos = targetPart.Position
        task.delay(0.06, function()
            if Camera then Camera.CFrame = oldCFrame end
        end)
    elseif shootMode == "Wallbang" and targetPart then
        hitInstance = targetPart
    end

    pcall(function()
        remote:FireServer(targetPos, hitInstance)
    end)
end

local function throwKnife()
    local remote, knifeTool = getKnifeRemote()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if not remote or not hrp then
        WindUI:Notify({ Title = "Knife Error", Content = "No valid Knife found or equipped!", Duration = 2 })
        return
    end

    if knifeTool and knifeTool.Parent == LocalPlayer.Backpack and hum then
        hum:EquipTool(knifeTool)
        task.wait(0.05)
    end

    local targetPart, _ = getNearestEnemyTarget()
    local targetPos = targetPart and targetPart.Position or (hrp.Position + hrp.CFrame.LookVector * 50)
    local originCFrame = hrp.CFrame

    pcall(function()
        remote:FireServer(originCFrame, targetPos)
    end)
end

RunService.RenderStepped:Connect(function()
    if aimbotEnabled then
        local targetPart, _ = getNearestEnemyTarget()
        if targetPart then
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, targetPart.Position)
        end
    end

    if triggerbotEnabled then
        local ray = Camera:ScreenPointToRay(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
        local rayParams = RaycastParams.new()
        rayParams.FilterDescendantsInstances = {LocalPlayer.Character}
        local result = Workspace:Raycast(ray.Origin, ray.Direction * 300, rayParams)
        if result and result.Instance and result.Instance.Parent then
            local p = Players:GetPlayerFromCharacter(result.Instance.Parent)
            if p and isEnemy(p) then
                fireGun()
                task.wait(0.15)
            end
        end
    end

    if hitboxExpanderEnabled then
        for _, p in pairs(Players:GetPlayers()) do
            if isEnemy(p) and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local hrp = p.Character.HumanoidRootPart
                hrp.Size = Vector3.new(hitboxSizeValue, hitboxSizeValue, hitboxSizeValue)
                hrp.Transparency = 0.7
                hrp.Material = Enum.Material.ForceField
                hrp.CanCollide = false
            end
        end
    end
end)

