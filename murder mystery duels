local function toggleInvisibility(state)
    invisEnabled = state
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not char then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.Transparency = state and 0.5 or 0
        end
    end

    if state then
        if invisConn then invisConn:Disconnect() end
        invisConn = RunService.Heartbeat:Connect(function()
            if not invisEnabled or not hrp or not hum or not char.Parent then return end
            local oldCF = hrp.CFrame
            local oldOffset = hum.CameraOffset
            local voidCF = oldCF * CFrame.new(0, -200000, 0)
            local offsetPos = voidCF:ToObjectSpace(CFrame.new(oldCF.Position)).Position
            
            hrp.CFrame = voidCF
            hum.CameraOffset = offsetPos
            RunService.RenderStepped:Wait()
            
            if hrp and hum then
                hrp.CFrame = oldCF
                hum.CameraOffset = oldOffset
            end
        end)
    else
        if invisConn then invisConn:Disconnect() invisConn = nil end
        if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
    end
end

