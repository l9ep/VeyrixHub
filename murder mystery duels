--------------------------------------------------------------------------------
-- MM DUELS ENEMY & MATCH PLOT FILTERING
--------------------------------------------------------------------------------

local function isEnemy(player)
    if not player or player == LocalPlayer then return false end
    
    local char = player.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end

    local matchPlots = Workspace:FindFirstChild("MatchPlots")
    if matchPlots then
        for _, plot in ipairs(matchPlots:GetChildren()) do
            local myCharInPlot = LocalPlayer.Character and LocalPlayer.Character:IsDescendantOf(plot)
            local enemyInPlot = char:IsDescendantOf(plot)
            if myCharInPlot and enemyInPlot then
                return true
            end
        end
    end

    if LocalPlayer.Team and player.Team then
        return LocalPlayer.Team ~= player.Team
    end

    return true
end

local function getNearestEnemyTarget()
    local nearestPlayer = nil
    local shortestDistance = math.huge

    for _, player in ipairs(Players:GetPlayers()) do
        if isEnemy(player) then
            local hrp = player.Character.HumanoidRootPart
            local dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDistance then
                shortestDistance = dist
                nearestPlayer = player
            end
        end
    end

    if nearestPlayer and nearestPlayer.Character then
        local targetPart = nearestPlayer.Character:FindFirstChild("HumanoidRootPart") or nearestPlayer.Character:FindFirstChild("Head")
        return targetPart, nearestPlayer
    end

    return nil, nil
end

--------------------------------------------------------------------------------
-- PERMANENT WHITE ESP
--------------------------------------------------------------------------------

local function setupPlayerESP(player)
    if player == LocalPlayer then return end

    local function applyHighlight(char)
        if char:FindFirstChild("VeyrixESP") then char.VeyrixESP:Destroy() end
        local hl = Instance.new("Highlight")
        hl.Name = "VeyrixESP"
        hl.Adornee = char
        hl.FillColor = Color3.fromRGB(255, 255, 255)
        hl.FillTransparency = 0.4
        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
        hl.OutlineTransparency = 0
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Enabled = espEnabled and isEnemy(player)
        hl.Parent = char
        activeHighlights[player] = hl
    end

    if player.Character then applyHighlight(player.Character) end
    player.CharacterAdded:Connect(function(char)
        task.wait(0.2)
        applyHighlight(char)
    end)
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayerESP(p) end
Players.PlayerAdded:Connect(setupPlayerESP)

local function updateESPState()
    for player, highlight in pairs(activeHighlights) do
        if highlight and highlight.Parent then
            highlight.Enabled = espEnabled and isEnemy(player)
        end
    end
end

--------------------------------------------------------------------------------
-- WEAPON REMOTES
--------------------------------------------------------------------------------

local function getGunRemote()
    local char = LocalPlayer.Character
    if not char then return nil end

    local tool = char:FindFirstChildOfClass("Tool")
    if tool and tool:FindFirstChild("GunServer") and tool.GunServer:FindFirstChild("ShootStart") then
        return tool.GunServer.ShootStart
    end

    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item:FindFirstChild("GunServer") and item.GunServer:FindFirstChild("ShootStart") then
                return item.GunServer.ShootStart
            end
        end
    end

    return nil
end

local function getKnifeRemote()
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    
    local knife = char and char:FindFirstChild("Knife") or backpack and backpack:FindFirstChild("Knife")
    if not knife and char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("knife") or item:FindFirstChild("KnifeServer")) then
                knife = item
                break
            end
        end
    end
    if not knife and backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and (item.Name:lower():find("knife") or item:FindFirstChild("KnifeServer")) then
                knife = item
                break
            end
        end
    end

    if knife and knife:FindFirstChild("KnifeServer") and knife.KnifeServer:FindFirstChild("FlingKnife") then
        return knife.KnifeServer.FlingKnife, knife
    end
    return nil, nil
end

--------------------------------------------------------------------------------
-- COMBAT ACTIONS
