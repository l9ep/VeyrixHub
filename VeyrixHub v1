-- HELPER: EXECUTE SILENT THROW (FRONT ONLY & CONDITIONAL WALLBANG)[span_16](start_span)[span_16](end_span)
function _G.ExecuteSilentThrow()
    local char = _G.localPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    local knife = char and char:FindFirstChild("Knife") or _G.localPlayer.Backpack:FindFirstChild("Knife")
    
    if not myHrp then return end

    local targetHrp = nil
    local shortestDist = math.huge

    for _, p in pairs(Players:GetPlayers()) do
        if _G.IsActiveInRound(p) then
            local tChar = p.Character
            local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if tHrp then
                local dirToTarget = tHrp.Position - myHrp.Position
                local dist = dirToTarget.Magnitude
                local unitDir = dirToTarget.Unit
                local lookVec = myHrp.CFrame.LookVector

                if lookVec:Dot(unitDir) > 0.1 then
                    local isValid = true
                    if not _G.Options.KnifeWallbang then
                        local rayParams = RaycastParams.new()
                        rayParams.FilterType = Enum.RaycastFilterType.Exclude
                        rayParams.FilterDescendantsInstances = {char, tChar}
                        local rayResult = Workspace:Raycast(myHrp.Position, dirToTarget, rayParams)
                        if rayResult then isValid = false end
                    end

                    if isValid and dist < shortestDist then
                        shortestDist = dist
                        targetHrp = tHrp
                    end
                end
            end
        end
    end
    
    if char and char:FindFirstChild("Humanoid") and targetHrp then
        local targetPlayer = Players:GetPlayerFromCharacter(targetHrp.Parent)
        if targetPlayer and not _G.IsActiveInRound(targetPlayer) then return end

        if knife and knife.Parent == _G.localPlayer.Backpack then
            char.Humanoid:EquipTool(knife)
            task.wait(0.03)
        end
        
        if knife and char.PrimaryPart then
            local thrownRemote = knife:FindFirstChild("Events") and knife.Events:FindFirstChild("KnifeThrown")
            if thrownRemote then 
                local predictedPos = _G.CalculatePredictedPos(targetHrp, 130)
                if predictedPos then
                    local originCF = char.PrimaryPart.CFrame
                    if _G.Options.KnifeWallbang then
                        local directDir = (predictedPos - char.PrimaryPart.Position).Unit
                        originCF = CFrame.new(predictedPos - (directDir * 1.5), predictedPos)
                    end
                    thrownRemote:FireServer(originCF, CFrame.new(predictedPos)) 
                end
            end
        end
    end
end

