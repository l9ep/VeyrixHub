function _G.ApplyLowGraphics(state)
    _G.Options.LowGraphics = state
    if state then
        originalLighting["GlobalShadows"] = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
        
        for _, effect in ipairs(Lighting:GetChildren()) do
            if effect:IsA("PostEffect") or effect:IsA("SunRaysEffect") or effect:IsA("Atmosphere") then
                if originalLighting[effect] == nil then originalLighting[effect] = effect.Enabled end
                effect.Enabled = false
            end
        end
    else
        if originalLighting["GlobalShadows"] ~= nil then
            Lighting.GlobalShadows = originalLighting["GlobalShadows"]
        end
        for effect, enabled in pairs(originalLighting) do
            if typeof(effect) == "Instance" and effect.Parent then
                effect.Enabled = enabled
            end
        end
    end
end

function _G.ApplyFPSBoost(state)
    _G.Options.FPSBoost = state
    if state then
        originalLighting["Technology"] = Lighting.Technology
        Lighting.Technology = Enum.Technology.Compatibility
        
        task.spawn(function()
            local count = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if not _G.Options.FPSBoost then break end
                
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                    if not originalMaterials[obj] then originalMaterials[obj] = { Enabled = obj.Enabled } end
                    obj.Enabled = false
                elseif obj:IsA("BasePart") and not obj:IsA("Terrain") then
                    if not originalMaterials[obj] then
                        originalMaterials[obj] = { Material = obj.Material, Reflectance = obj.Reflectance, CastShadow = obj.CastShadow }
                    end
                    obj.Material = Enum.Material.SmoothPlastic
                    obj.Reflectance = 0
                    obj.CastShadow = false
                end
                
                count = count + 1
                if count % 200 == 0 then task.wait() end
            end
        end)
    else
        if originalLighting["Technology"] then
            Lighting.Technology = originalLighting["Technology"]
        end
        
        task.spawn(function()
            local count = 0
            for obj, props in pairs(originalMaterials) do
                if obj and obj.Parent then
                    if obj:IsA("BasePart") then
                        obj.Material = props.Material
                        obj.Reflectance = props.Reflectance
                        obj.CastShadow = props.CastShadow
                    elseif obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Smoke") or obj:IsA("Fire") or obj:IsA("Sparkles") then
                        obj.Enabled = props.Enabled
                    end
                end
                count = count + 1
                if count % 200 == 0 then task.wait() end
            end
            table.clear(originalMaterials)
        end)
    end
end

function _G.ApplyRemoveTextures(state)
    _G.Options.RemoveTextures = state
    if state then
        task.spawn(function()
            local count = 0
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if not _G.Options.RemoveTextures then break end
                if obj:IsA("Decal") or obj:IsA("Texture") then
                    if not originalDecals[obj] then originalDecals[obj] = obj.Transparency end
                    obj.Transparency = 1
                end
                count = count + 1
                if count % 200 == 0 then task.wait() end
            end
        end)
    else
        task.spawn(function()
            local count = 0
            for obj, trans in pairs(originalDecals) do
                if obj and obj.Parent then
                    obj.Transparency = trans
                end
                count = count + 1
                if count % 200 == 0 then task.wait() end
            end
            table.clear(originalDecals)
        end)
    end
end

