function _G.GetCoinCount()
    local coinData = _G.pGui:FindFirstChild("Main") and _G.pGui.Main:FindFirstChild("Coins")
    if coinData then
        local coinLabel = coinData:FindFirstChild("Amount") or coinData:FindFirstChildOfClass("TextLabel")
        if coinLabel then
            local collected = coinLabel.Text:match("(%d+)")
            return tonumber(collected) or 0
        end
    end
    
    local leaderstats = _G.localPlayer:FindFirstChild("leaderstats")
    if leaderstats and leaderstats:FindFirstChild("Coins") then
        return leaderstats.Coins.Value
    end
    return 0
end

function _G.GetNextTargetCoin()
    local validNames = {
        ["coin"] = true, ["coinserver"] = true, ["coinold"] = true, 
        ["maincoin"] = true, ["candy"] = true, ["snowflake"] = true
    }
    
    local function checkCoin(instance)
        if not instance then return nil end
        local nameLower = instance.Name:lower()
        if validNames[nameLower] then
            local part = instance:IsA("BasePart") and instance or instance:FindFirstChildOfClass("BasePart")
            if part and part.Transparency < 1 then
                return part
            end
        end
        return nil
    end

    local activeMap = Workspace:FindFirstChild("Normal") or Workspace:FindFirstChild("CoinContainer")
    if activeMap then
        for _, descendant in ipairs(activeMap:GetDescendants()) do
            local foundPart = checkCoin(descendant)
            if foundPart then return foundPart end
        end
    end

    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and obj.Name ~= _G.localPlayer.Name and not Players:GetPlayerFromCharacter(obj) then
            for _, descendant in ipairs(obj:GetDescendants()) do
                local foundPart = checkCoin(descendant)
                if foundPart then return foundPart end
            end
        end
    end

    for _, descendant in ipairs(Workspace:GetDescendants()) do
        local foundPart = checkCoin(descendant)
        if foundPart then return foundPart end
    end

    return nil
end

function _G.TPTo(target)
    if not target or not _G.localPlayer.Character then return end
    local hrp = _G.localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    
    if typeof(target) == "Instance" then
        if target:IsA("BasePart") then
            hrp.CFrame = target.CFrame * CFrame.new(0, 0, 2)
        elseif target:IsA("Model") then
            if target.PrimaryPart then
                hrp.CFrame = target.PrimaryPart.CFrame * CFrame.new(0, 0, 2)
            else
                local anyPart = target:FindFirstChildOfClass("BasePart")
                if anyPart then hrp.CFrame = anyPart.CFrame * CFrame.new(0, 0, 2) end
            end
        end
    elseif typeof(target) == "CFrame" then
        hrp.CFrame = target
    elseif typeof(target) == "Vector3" then
        hrp.CFrame = CFrame.new(target)
    end
end

function _G.TweenToCoin(targetPart)
    local char = _G.localPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetPart or not targetPart.Parent then return end

    local flySpeed = math.clamp(_G.Options.FlySpeed or 14, 10, 16)
    local targetCF = targetPart.CFrame * CFrame.new(0, 0.5, 0)
    local distance = (targetPart.Position - hrp.Position).Magnitude
    local duration = math.clamp(distance / flySpeed, 0.1, 4.0)

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.Out
    )

    local tween = TweenService:Create(hrp, tweenInfo, { CFrame = targetCF })

    local noclipConn = RunService.Stepped:Connect(function()
        if not _G.Options.AutoFarmCoins or not targetPart or not targetPart.Parent then
            if tween then tween:Cancel() end
            return
        end
        
        if char then
            for _, part in ipairs(char:GetChildren()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end
    end)

    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    tween:Play()
    tween.Completed:Wait()

    if noclipConn then noclipConn:Disconnect() end
end

