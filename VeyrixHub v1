local invisConnection = nil

function _G.handleInvisToggle(state)
    _G.Options.InvisibilityExploit = state
    _G.UpdateCharCache()
    
    local char = _G.localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    
    for _, part in pairs(_G.CharParts) do
        part.Transparency = state and 0.5 or 0
    end
    
    if state then
        if invisConnection then invisConnection:Disconnect() end
        
        invisConnection = RunService.Heartbeat:Connect(function()
            if not _G.Options.InvisibilityExploit then return end
            if not hrp or not hum or not char.Parent then return end
            
            local oldCF = hrp.CFrame
            local oldOffset = hum.CameraOffset
            local voidCF = oldCF * CFrame.new(0, -200000, 0)
            local offsetPos = voidCF:ToObjectSpace(CFrame.new(oldCF.Position)).Position
            
            hrp.CFrame = voidCF
            hum.CameraOffset = offsetPos
            
            RunService.RenderStepped:Wait()
            
            if hrp and hum then
                hrp.CFrame = oldCF
                hum.CameraOffset = oldOffset
            end
        end)
    else
        if invisConnection then
            invisConnection:Disconnect()
            invisConnection = nil
        end
        if hum then hum.CameraOffset = Vector3.new(0, 0, 0) end
    end
end

