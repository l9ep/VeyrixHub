                        end
                        h.FillColor = roleColor
                    end
                end
            end
        end

        if _G.Options.AntiFling then
            local myChar = _G.localPlayer.Character
            if myChar then
                for _, part in ipairs(myChar:GetChildren()) do
                    if part:IsA("BasePart") then
                        if part.Velocity.Magnitude > 150 or part.RotVelocity.Magnitude > 150 then
                            part.Velocity = Vector3.zero
                            part.RotVelocity = Vector3.zero
                        end
                    end
                end
                
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= _G.localPlayer and p.Character then
                        for _, otherPart in ipairs(p.Character:GetChildren()) do
