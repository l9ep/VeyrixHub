        _G.Options.AutoDodgeRole = v
        
        if _G.DodgeConnection then
            _G.DodgeConnection:Disconnect()
            _G.DodgeConnection = nil
        end
        
        if v then
            _G.DodgeConnection = RunService.Heartbeat:Connect(function()
                if not _G.Options.AutoDodgeRole then return end
                
                local myChar = _G.localPlayer.Character
                local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
                if not myHrp then return end

                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {myChar}

                local function getBestDodgeVector(threatPos, isProjectile)
                    local baseDir = (myHrp.Position - threatPos).Unit
                    if baseDir ~= baseDir then baseDir = Vector3.new(1, 0, 0) end
                    
                    local rightDir = baseDir:Cross(Vector3.new(0, 1, 0))
                    local leftDir = -rightDir
                    local backDir = baseDir
                    
                    local directions = { rightDir, leftDir, backDir }
                    local maxPushDistance = isProjectile and 6 or 4.5
                    
                    for _, dir in ipairs(directions) do
                        local wallRay = Workspace:Raycast(myHrp.Position, dir * maxPushDistance, rayParams)
                        local floorRay = Workspace:Raycast(myHrp.Position + (dir * (maxPushDistance * 0.8)), Vector3.new(0, -10, 0), rayParams)
                        
                        if not wallRay and floorRay and floorRay.Instance then
                            return dir * maxPushDistance
                        elseif wallRay then
                            local safeDistance = math.max(0, wallRay.Distance - 1.2)
                            local altFloor = Workspace:Raycast(myHrp.Position + (dir * safeDistance), Vector3.new(0, -10, 0), rayParams)
                            if safeDistance > 1.5 and altFloor and altFloor.Instance then
                                return dir * safeDistance
                            end
                        end
                    end
                    
                    return nil
                end

                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= _G.localPlayer and _G.IsActiveInRound(p) then
                        local otherChar = p.Character
                        local otherHrp = otherChar and otherChar:FindFirstChild("HumanoidRootPart")
                        if otherHrp then
                            local dist = (myHrp.Position - otherHrp.Position).Magnitude
                            local otherRole = _G.DetectPreRoundRole(p)
                            local triggerDist = (otherRole == "Murderer" and 12) or ((otherRole == "Sheriff" or otherRole == "Hero") and 18) or 6
                            
                            if dist < triggerDist then
                                local dodgeVec = getBestDodgeVector(otherHrp.Position, false)
                                if dodgeVec then
                                    myHrp.CFrame = myHrp.CFrame + dodgeVec
                                end
                            end
                        end
                    end
                end
                
                for _, obj in ipairs(Workspace:GetChildren()) do
                    if obj.Name == "FlyingKnife" or obj.Name == "Knife" or obj.Name == "RevolverBullet" then
                        local pPart = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                        if pPart then
                            local dist = (myHrp.Position - pPart.Position).Magnitude
                            if dist < 16 then
                                local dodgeVec = getBestDodgeVector(pPart.Position, true)
                                if dodgeVec then
                                    myHrp.CFrame = myHrp.CFrame + dodgeVec
                                end
                            end
                        end
                    end
                end
            end)
        end
    end
