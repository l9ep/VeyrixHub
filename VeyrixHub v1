RunService.RenderStepped:Connect(function()
    local localHrp = _G.localPlayer.Character and _G.localPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not localHrp then return end

    if _G.Options.HitboxExpander then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= _G.localPlayer and _G.IsActiveInRound(p) then
                local hrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.Size = Vector3.new(_G.Options.HitboxSize, _G.Options.HitboxSize, _G.Options.HitboxSize)
                    hrp.Transparency = 0.7
                    hrp.Material = Enum.Material.ForceField
                    hrp.CanCollide = false
                end
            end
        end
    end

    if _G.Options.KnifeHitboxExpander then
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.Name == "FlyingKnife" or obj.Name == "Knife" then
                local myChar = _G.localPlayer.Character
                if not (myChar and obj:IsDescendantOf(myChar)) and obj.Parent == Workspace then
                    local pPart = obj:IsA("BasePart") and obj or obj:FindFirstChildOfClass("BasePart")
                    if pPart then
                        pPart.Size = Vector3.new(_G.Options.KnifeHitboxSize, _G.Options.KnifeHitboxSize, _G.Options.KnifeHitboxSize)
                        pPart.Transparency = 0.6
                        pPart.CanCollide = false
                    end
                end
            end
        end
    end

    if _G.Options.Aimbot then
        local Cam = Workspace.CurrentCamera
        local myRole = _G.DetectPreRoundRole(_G.localPlayer)
        local targetRole = (myRole == "Murderer" and "Sheriff") or "Murd"
        local optimalTarget = _G.getTarget(targetRole) or _G.getTarget("Closest")
        
        if optimalTarget and optimalTarget.Parent then
            local targetHead = optimalTarget.Parent:FindFirstChild("Head") or optimalTarget
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, targetHead.Position)
        end
    end
    
    if _G.Options.AutoStab then
        local remote = _G.GetNil("KnifeStabbed", "1_507456")
        local cTarget = _G.getTarget("Closest")
        if remote and cTarget then
            local dist = (localHrp.Position - cTarget.Position).Magnitude
            if dist <= 4.5 and _G.IsActiveInRound(Players:GetPlayerFromCharacter(cTarget.Parent)) then remote:FireServer() end
        end
    end
end)

-- INTEGRATED STABLE SILENT AIM HOOK (Dead Body Filtered)[span_37](start_span)[span_37](end_span)[span_38](start_span)[span_38](end_span)
if hookmetamethod then
    local oldIndex
    oldIndex = hookmetamethod(game, "__index", function(self, index)
        if not checkcaller() and self == _G.Mouse and (index == "Hit" or index == "Target") then
            local myChar = _G.localPlayer.Character
            local localHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            
            if localHrp then
                local targetHrp = nil
                if _G.Options.AutoKillMurderer then
                    targetHrp = _G.getTarget("Murd")
                elseif _G.Options.SilentAim or _G.ShootMode == "Wallbang" or _G.Options.KnifeWallbang then
                    local myRole = _G.DetectPreRoundRole(_G.localPlayer)
                    targetHrp = (myRole == "Murderer" and (_G.getTarget("Sheriff") or _G.getTarget("Closest"))) or _G.getTarget("Murd")
                end

                if targetHrp and targetHrp.Parent then
                    local targetPlayer = Players:GetPlayerFromCharacter(targetHrp.Parent)
                    if targetPlayer and _G.IsActiveInRound(targetPlayer) then
                        local targetHead = targetHrp.Parent:FindFirstChild("Head") or targetHrp
                        local predictedPos = _G.CalculatePredictedPos(targetHrp, 200)

                        if predictedPos then
                            if index == "Hit" then
                                return CFrame.new(predictedPos)
                            elseif index == "Target" then
                                return targetHead
                            end
                        end
                    end
                end
            end
        end
        return oldIndex(self, index)
    end)
end