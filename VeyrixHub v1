function _G.UpdateCharCache()
    _G.CharParts = {}
    local char = _G.localPlayer.Character
    if char then
        for _, obj in pairs(char:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name ~= "HumanoidRootPart" then
                table.insert(_G.CharParts, obj)
            end
        end
    end
end

function _G.BringGunToPlayer()
    local char = _G.localPlayer.Character
    local localHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not localHrp then return end

    local gunDrop = nil
    for _, v in pairs(Workspace:GetDescendants()) do
        if v.Name == "GunDrop" or (v.Name == "Gun" and v.Parent == Workspace) then
            gunDrop = v
            break
        end
    end

    if gunDrop then
        task.spawn(function()
            local gunPart = gunDrop:IsA("BasePart") and gunDrop or gunDrop:FindFirstChild("Handle") or gunDrop:FindFirstChildOfClass("BasePart")
            if not gunPart then return end
            
            local startTime = tick()
            repeat
                if gunPart and gunPart.Parent and localHrp then
                    gunPart.CFrame = localHrp.CFrame
                    
                    if firetouchinterest then
                        firetouchinterest(gunPart, localHrp, 0)
                        task.wait()
                        firetouchinterest(gunPart, localHrp, 1)
                    end
                end
                task.wait(0.02)
            until not gunDrop.Parent or (tick() - startTime > 3)
        end)
    end
end

function _G.GetClosestInnocent()
    local closest, dist = nil, math.huge
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= _G.localPlayer and _G.IsActiveInRound(p) then
            local role = _G.DetectPreRoundRole(p)
            if role == "Innocent" then
                local myHrp = _G.localPlayer.Character and _G.localPlayer.Character:FindFirstChild("HumanoidRootPart")
                local targetHrp = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
                if targetHrp then
                    local d = myHrp and (myHrp.Position - targetHrp.Position).Magnitude or 0
                    if d < dist then
                        dist = d
                        closest = p
                    end
                end
            end
        end
    end
    return closest
end

