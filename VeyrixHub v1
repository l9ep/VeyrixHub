--------------------------------------------------------------------------------
-- ROMEN KNOCKOUT & AIR STRAFE ENGINE
--------------------------------------------------------------------------------

local lastBumpTime = 0

local function applyJumpBoost()
    if not _G.Options.JumpBoost then return end
    
    local char = _G.localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp and hum then
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude == 0 then
            moveDir = hrp.CFrame.LookVector
        end
        
        local forwardForce = _G.Options.JumpBoostPower or 120
        hrp.AssemblyLinearVelocity = Vector3.new(
            moveDir.X * forwardForce,
            hrp.AssemblyLinearVelocity.Y,
            moveDir.Z * forwardForce
        )
    end
end

local function isPropObjectOnly(hitInstance)
    if not hitInstance or not hitInstance.CanCollide then return false end
    
    local name = hitInstance.Name:lower()
    local pName = hitInstance.Parent and hitInstance.Parent.Name:lower() or ""
    
    if name:find("wall") or name:find("floor") or name:find("ceiling") or name:find("baseplate") or name:find("ground") or name:find("map") or name:find("structure") or name:find("wedge") then
        return false
    end
    if pName:find("wall") or pName:find("structure") or pName:find("architecture") or pName == "map" or pName == "workspace" then
        return false
    end
    
    if hitInstance.Parent and hitInstance.Parent:IsA("Model") and not hitInstance.Parent:FindFirstChildOfClass("Humanoid") then
        return true
    end
    
    if name:find("prop") or name:find("chair") or name:find("table") or name:find("box") or name:find("desk") or name:find("coin") or name:find("barrel") or name:find("crate") or name:find("bench") then
        return true
    end
    
    return false
end

RunService.Stepped:Connect(function()
    if not _G.Options.JumpBoost then return end
    
    local char = _G.localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    if hrp and hum and hum.Health > 0 then
        local moveDir = hum.MoveDirection
        
        if moveDir.Magnitude > 0 then
            if hum:GetState() == Enum.HumanoidStateType.Freefall then
                local strafeSpeed = _G.Options.StrafeSpeed or 100
                local currentVel = hrp.AssemblyLinearVelocity
                hrp.AssemblyLinearVelocity = Vector3.new(
                    moveDir.X * strafeSpeed,
                    currentVel.Y,
                    moveDir.Z * strafeSpeed
                )
            end
            
            if tick() - lastBumpTime > 0.35 then
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Exclude
                rayParams.FilterDescendantsInstances = {char}
                
                local bumpRay = Workspace:Raycast(hrp.Position, moveDir.Unit * 3.5, rayParams)
                if bumpRay and bumpRay.Instance and isPropObjectOnly(bumpRay.Instance) then
                    lastBumpTime = tick()
                    local currentVel = hrp.AssemblyLinearVelocity
                    local bouncePower = _G.Options.RomenBouncePower or 180
                    local reflectDir = (hrp.Position - bumpRay.Position).Unit
                    
                    hrp.AssemblyLinearVelocity = Vector3.new(
                        (reflectDir.X * bouncePower * 0.5) + (currentVel.X * 1.2),
                        bouncePower,
                        (reflectDir.Z * bouncePower * 0.5) + (currentVel.Z * 1.2)
                    )
                end
            end
        end
    end
end)

local function hookHumanoidJump(char)
    if not char then return end
    local hum = char:WaitForChild("Humanoid", 5)
    if hum then
        hum.Jumping:Connect(function()
            applyJumpBoost()
        end)
    end
end

