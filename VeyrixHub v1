-- Asset ID Auto-Formatter Helper Function
function _G.FormatAssetId(input)
    if not input then return "rbxassetid://6031094678" end
    local cleanId = tostring(input):match("%d+")
    if cleanId then
        return "rbxassetid://" .. cleanId
    end
    return "rbxassetid://6031094678"
end

