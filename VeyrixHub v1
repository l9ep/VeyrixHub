function _G.ExecuteGunShoot()
    local t = _G.getTarget("Murd") or _G.getTarget("Closest")
    local shootRemote = _G.GetShootRemote()
    local char = _G.localPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    
    local gun = char and (char:FindFirstChild("Gun") or char:FindFirstChild("Revolver") or char:FindFirstChild("DefaultGun"))
    if not gun and _G.localPlayer.Backpack then
        gun = _G.localPlayer.Backpack:FindFirstChild("Gun") or _G.localPlayer.Backpack:FindFirstChild("Revolver") or _G.localPlayer.Backpack:FindFirstChild("DefaultGun")
        if gun and hum then
            hum:EquipTool(gun)
            task.wait(0.05)
        end
    end

    if shootRemote and t and char and char.PrimaryPart then 
        local predictedPos = _G.CalculatePredictedPos(t, 200)
        if not predictedPos then predictedPos = t.Position end
        local predictedCF = CFrame.new(predictedPos)

        if _G.ShootMode == "Flick" then
            local Cam = Workspace.CurrentCamera
            local oldCFrame = Cam.CFrame
            Cam.CFrame = CFrame.new(Cam.CFrame.Position, predictedPos)
            shootRemote:FireServer(char.PrimaryPart.CFrame, predictedCF)
            task.delay(0.08, function() Cam.CFrame = oldCFrame end)
        elseif _G.ShootMode == "Wallbang" or _G.Options.KnifeWallbang then
            local wallbangOrigin = CFrame.new(predictedPos + Vector3.new(0, 0.5, 0))
            shootRemote:FireServer(wallbangOrigin, predictedCF)
        else
            shootRemote:FireServer(char.PrimaryPart.CFrame, predictedCF)
        end
    end
end

